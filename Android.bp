cc_binary {
    name: "timekeep",
    srcs: ["timekeep.c"],
    shared_libs: [
        "libcutils",
        "liblog",
    ],
    init_rc: ["timekeep.rc"],
    owner: "sony",
    proprietary: true,
}

// Product makefiles that still list the former app get the binary.
phony {
    name: "TimeKeep",
    required: ["timekeep"],
}

genrule {
    name: "gen-com.sony.timekeep.rc",
    srcs: ["timekeep.rc"],
    out: ["com.sony.timekeep.rc"],
    cmd: "sed -E 's%/vendor/bin/%/apex/com.sony.timekeep/bin/%' $(in) > $(out)",
}

prebuilt_etc {
    name: "com.sony.timekeep.rc",
    src: ":gen-com.sony.timekeep.rc",
    installable: false,
}

apex {
    name: "com.sony.timekeep",

    key: "com.android.hardware.key",
    certificate: ":com.android.hardware.certificate",

    androidManifest: "apex_AndroidManifest.xml",
    file_contexts: "apex_file_contexts",
    manifest: "apex_manifest.json",

    updatable: false,
    proprietary: true,

    binaries: ["timekeep"],
    prebuilts: ["com.sony.timekeep.rc"],

    overrides: [
        "TimeKeep",
        "timekeep",
    ],
}
